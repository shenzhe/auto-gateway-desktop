{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AUTO Gateway Desktop",
  "version": "0.1.42",
  "identifier": "cc.autogateway.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AUTO Gateway Desktop",
        "width": 1440,
        "height": 1024,
        "center": true,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      },
      {
        "label": "tray-popup",
        "title": "AUTO Gateway",
        "width": 360,
        "height": 300,
        "minWidth": 360,
        "minHeight": 300,
        "maxWidth": 360,
        "maxHeight": 300,
        "visible": false,
        "focus": false,
        "focusable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://autogateway.cc https://api.autogateway.cc https://sg.autogateway.cc; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows-installer.nsh",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["autogateway"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBMTJEMjg2RjMyODZGN0MKUldSOGJ5anpodElTS3Vsd21idHZDNThDSUVNcGJJMTlpcUc1MEh6WCt3SXJJRU14TjY0U0tzaTEK",
      "endpoints": ["https://cdn.autogateway.cc/downloads/desktop/latest.json"]
    }
  }
}
