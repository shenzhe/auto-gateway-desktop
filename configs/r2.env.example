# Copy this file to configs/r2.env and fill in the production values.
# Never commit the real file or its credentials.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET=desktop-releases
R2_PUBLIC_BASE_URL=https://cdn.autogateway.cc
AWS_ACCESS_KEY_ID="<r2-access-key-id>"
AWS_SECRET_ACCESS_KEY="<r2-secret-access-key>"

# Optional release notes written to latest.json.
RELEASE_NOTES="Bug fixes and improvements."
